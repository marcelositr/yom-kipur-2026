---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Caminho para Yom Kipur 5787',
  description = 'Caminhada de estudo, reflexão e preparação para Yom Kipur 5787.'
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="container header-inner">
          <a class="brand" href={import.meta.env.BASE_URL}>
            Caminho para Yom Kipur
            <small>5787 · 2026</small>
          </a>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <div class="container">Marcelo Trindade · @marcelositr · devnux.com.br</div>
      </footer>
    </div>
  </body>
</html>

---
import '../styles/global.css';
import { marcos } from '../data/marcos';
import { studyFileFor } from '../data/studies';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string;
}

const {
  title = 'Caminho para Yom Kipur 5787',
  description = 'Caminhada de estudo, reflexão e preparação para Yom Kipur 5787.',
  socialImage = '/assets/social/yom-kipur-2026-og.jpg'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(socialImage, siteUrl).toString();
const socialImageAlt = 'Caminho para Yom Kipur 5787 · 15 marcos de estudo, reflexão e preparação para Yom Kipur 2026';
const orderedMarcos = [...marcos].sort((a, b) => a.id - b.id);
const pathname = Astro.url.pathname;
const marcoRouteMatch = pathname.match(/\/marcos\/(\d{2})-/);
const studyRouteMatch = pathname.match(/\/estudos\/(\d{2})-/);
const routeMatch = marcoRouteMatch ?? studyRouteMatch;
const isMarcoPage = Boolean(marcoRouteMatch);
const isStudyPage = Boolean(studyRouteMatch);
const currentId = routeMatch ? Number(routeMatch[1]) : undefined;
const currentIndex = currentId
  ? orderedMarcos.findIndex((item) => item.id === currentId)
  : -1;
const currentMarco = currentIndex >= 0 ? orderedMarcos[currentIndex] : undefined;
const previousMarco = currentIndex > 0 ? orderedMarcos[currentIndex - 1] : undefined;
const nextMarco = currentIndex >= 0 && currentIndex < orderedMarcos.length - 1
  ? orderedMarcos[currentIndex + 1]
  : undefined;
const currentStudyFile = currentMarco ? studyFileFor(currentMarco.id) : undefined;
const currentStudyHref = currentMarco && currentStudyFile
  ? `${base}estudos/${String(currentMarco.id).padStart(2, '0')}-${currentMarco.slug}/`
  : undefined;

const marcoHref = (id: number, slug: string) =>
  `${base}marcos/${String(id).padStart(2, '0')}-${slug}/`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#173d32" />

    <link rel="icon" type="image/png" href="https://devnux.com.br/assets/images/favicon.png?v=2" />
    <link rel="shortcut icon" href="https://devnux.com.br/assets/images/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="https://devnux.com.br/assets/images/favicon.png?v=2" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Caminho para Yom Kipur 5787" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="315" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="container header-inner">
          <a class="brand" href={base}>
            Caminho para Yom Kipur
            <small>5787 · 2026</small>
          </a>
          <nav class="site-nav" aria-label="Navegação principal">
            <a href={`${base}#sobre`}>Sobre</a>
            <a href={`${base}#como-usar`}>Como usar</a>
            <a href={`${base}#cronograma`}>Cronograma</a>
            <a href={`${base}#marcos`}>Marcos</a>
          </nav>
        </div>
      </header>

      {currentMarco && (
        <div class="marco-context">
          <div class="container marco-context__inner">
            <a href={`${base}#marcos`}>Todos os Marcos</a>
            <span aria-hidden="true">·</span>
            <strong>
              {isStudyPage ? 'Estudo · ' : ''}Marco {String(currentMarco.id).padStart(2, '0')} de {orderedMarcos.length}
            </strong>
            <span aria-hidden="true">·</span>
            <span>{currentMarco.hebrewDate}</span>
          </div>
        </div>
      )}

      {currentMarco && currentStudyHref && isMarcoPage && (
        <aside class="study-access" aria-label="Estudo complementar deste Marco">
          <div class="container study-access__inner">
            <div>
              <span class="study-access__kicker">Material de apoio</span>
              <strong>Estudo complementar · Marco {String(currentMarco.id).padStart(2, '0')}</strong>
              <p>Leia com mais contexto, ajuste o tamanho do texto, ouça o estudo e compartilhe quando quiser.</p>
            </div>
            <a class="study-access__button" href={currentStudyHref}>
              Ler estudo
            </a>
          </div>
        </aside>
      )}

      <main><slot /></main>

      {currentMarco && isMarcoPage && (
        <nav class="marco-pagination container" aria-label="Navegação entre os Marcos">
          <div class="marco-pagination__side">
            {previousMarco ? (
              <a href={marcoHref(previousMarco.id, previousMarco.slug)} rel="prev">
                <small>Anterior</small>
                <strong>← Marco {String(previousMarco.id).padStart(2, '0')} · {previousMarco.title}</strong>
              </a>
            ) : <span class="marco-pagination__empty"></span>}
          </div>

          <a class="marco-pagination__all" href={`${base}#marcos`}>Ver os 15 Marcos</a>

          <div class="marco-pagination__side marco-pagination__side--next">
            {nextMarco ? (
              <a href={marcoHref(nextMarco.id, nextMarco.slug)} rel="next">
                <small>Próximo</small>
                <strong>Marco {String(nextMarco.id).padStart(2, '0')} · {nextMarco.title} →</strong>
              </a>
            ) : (
              <span class="marco-pagination__finish">
                <small>Fim da caminhada</small>
                <strong>Ne’ilá encerra o arco principal.</strong>
              </span>
            )}
          </div>
        </nav>
      )}

      {currentMarco && isStudyPage && (
        <nav class="marco-pagination container" aria-label="Continuidade após o estudo">
          <div class="marco-pagination__side">
            <a href={marcoHref(currentMarco.id, currentMarco.slug)}>
              <small>Voltar ao Marco</small>
              <strong>← Marco {String(currentMarco.id).padStart(2, '0')} · {currentMarco.title}</strong>
            </a>
          </div>

          <a class="marco-pagination__all" href={`${base}#marcos`}>Ver os 15 Marcos</a>

          <div class="marco-pagination__side marco-pagination__side--next">
            {nextMarco ? (
              <a href={marcoHref(nextMarco.id, nextMarco.slug)} rel="next">
                <small>Continuar a caminhada</small>
                <strong>Marco {String(nextMarco.id).padStart(2, '0')} · {nextMarco.title} →</strong>
              </a>
            ) : (
              <span class="marco-pagination__finish">
                <small>Fim da caminhada</small>
                <strong>Ne’ilá encerra o arco principal.</strong>
              </span>
            )}
          </div>
        </nav>
      )}

      <footer class="site-footer">
        <div class="container site-footer__inner">
          <span>Marcelo Trindade · @marcelositr · devnux.com.br</span>
          <span>Estudo e preparação · tradição judaica apresentada com fontes e contexto</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .study-access {
    border-bottom: 1px solid var(--line);
    background: #f7f1e5;
  }

  .study-access__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.15rem;
  }

  .study-access__inner > div {
    min-width: 0;
  }

  .study-access__kicker {
    display: block;
    margin-bottom: .25rem;
    color: var(--gold);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .study-access strong {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .study-access p {
    margin: .35rem 0 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .study-access__button {
    flex: 0 0 auto;
    padding: .8rem 1rem;
    border-radius: 999px;
    background: var(--forest);
    color: var(--ivory);
    font-size: .9rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .study-access__button:hover,
  .study-access__button:focus-visible {
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  @media (max-width: 700px) {
    .study-access__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

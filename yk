#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Caminho para Yom Kipur 5787
Launcher local do projeto

USO
  bash yk <comando> [parâmetros]

COMANDOS
  setup
    Prepara o ambiente de desenvolvimento.
    Faz: ativa/instala o Node definido em .nvmrc, instala dependências npm,
    instala o Chromium do Playwright e executa a validação completa.

    Uso:
      bash yk setup

  dev [--open|-o]
    Inicia o Astro em modo desenvolvimento.
    O processo fica ativo no terminal até você pressionar Ctrl+C.

    Parâmetros:
      --open, -o   abre o navegador automaticamente assim que o servidor responder

    Uso:
      bash yk dev
      bash yk dev --open

  open [CAMINHO]
    Abre no navegador o localhost do projeto que já estiver rodando.
    Sem parâmetro, abre a página inicial.

    Parâmetros:
      CAMINHO      rota relativa dentro do projeto

    Uso:
      bash yk open
      bash yk open marcos/01-o-rei-esta-no-campo/

  test
    Executa a validação completa do projeto.
    Faz: valida os dados dos marcos, roda astro check e gera o build estático.

    Uso:
      bash yk test

  render [N]
    Renderiza em PNG o card do marco informado.
    Se N não for fornecido, usa o Marco 01.
    Quando possível, abre automaticamente o PNG gerado.

    Parâmetros:
      N            número inteiro do marco, por exemplo 1, 2, 3...

    Uso:
      bash yk render
      bash yk render 1

  doctor
    Mostra um diagnóstico rápido do ambiente local.
    Exibe branch Git, fnm, Node, npm, versão definida em .nvmrc,
    presença de node_modules e cache do Playwright.

    Uso:
      bash yk doctor

  help
    Mostra esta ajuda.

    Uso:
      bash yk help
      bash yk -h
      bash yk --help

ATALHOS ÚTEIS
  Primeira preparação:
    bash yk setup

  Trabalhar no site e abrir o navegador automaticamente:
    bash yk dev --open

  Abrir o localhost se o Astro já estiver rodando:
    bash yk open

  Validar tudo:
    bash yk test

  Gerar o card do Marco 01:
    bash yk render 1

LOCALHOST PADRÃO
  http://localhost:4321/yom-kipur-2026/
EOF
}

command="${1:-help}"
shift || true

case "$command" in
  setup)
    exec bash "$ROOT/scripts/setup.sh" "$@"
    ;;
  dev)
    exec bash "$ROOT/scripts/dev.sh" "$@"
    ;;
  open)
    exec bash "$ROOT/scripts/open.sh" "$@"
    ;;
  test)
    exec bash "$ROOT/scripts/test.sh" "$@"
    ;;
  render)
    exec bash "$ROOT/scripts/render-card.sh" "$@"
    ;;
  doctor)
    exec bash "$ROOT/scripts/doctor.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Comando desconhecido: %s\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
